# IoT Smart Switch - Environment Configuration Template
# Copy this file to .env and provide your specific credentials if using custom environment runners.
# NOTE: Standard Flutter Firebase apps use firebase_options.dart and google-services.json / GoogleService-Info.plist.

# Firebase Configuration (Public Client Metadata)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=AIzaSyPlaceholderAPIKey
FIREBASE_APP_ID=1:123456789:android:placeholder
FIREBASE_MESSAGING_SENDER_ID=123456789

# Hardware Settings
ESP32_DEFAULT_DEVICE_ID=esp32_001
ESP32_HEARTBEAT_INTERVAL_MS=10000
ESP32_OFFLINE_TIMEOUT_SECONDS=25
