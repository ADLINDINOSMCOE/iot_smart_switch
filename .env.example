# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
#
# SECURITY GUIDELINE:
# Copy this file to .env for local development overrides if needed.
# DO NOT commit real secrets (.env) to version control.
#
# UNDERSTANDING FIREBASE CLIENT CREDENTIALS VS. SERVER SECRETS:
# -----------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Safe in Flutter app & version control):
#    - Firebase API Key (e.g. AIzaSy...)
#    - Firebase Project ID (e.g. iot-switch-23826)
#    - Firebase App ID (e.g. 1:853694975111:android:...)
#    - Storage Bucket URL
#    These are client-side routing identifiers that allow the Flutter app
#    to communicate with Firebase services. Security is NOT enforced by hiding
#    these keys, but by Firebase Authentication and Firestore Security Rules.
#
# 2. PRIVATE SERVER SECRETS (MUST NEVER BE IN FLUTTER APP OR GITHUB):
#    - Firebase Service Account Key (serviceAccountKey.json)
#    - Database Admin tokens
#    - Wi-Fi Passwords (for ESP32)
#    - Hardware Pre-Shared Device Tokens (secrets.h)
# =============================================================================

# Optional local dev overrides:
APP_ENVIRONMENT=production
ENABLE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
