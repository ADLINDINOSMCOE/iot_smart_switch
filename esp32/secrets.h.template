#ifndef SECRETS_H
#define SECRETS_H

// =============================================================================
// ESP32 SMART SWITCH SECURITY CONFIGURATION
//
// INSTRUCTIONS:
// 1. Copy this file to "secrets.h" in the same directory (esp32/secrets.h).
// 2. Fill in your actual Wi-Fi and Firebase project credentials.
// 3. NEVER commit "secrets.h" to version control or public repositories.
// =============================================================================

// --- Wi-Fi Credentials ---
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"

// --- Firebase Configuration ---
// Project ID found in your Firebase Console / firebase_options.dart
#define FIREBASE_PROJECT_ID "iot-switch-23826"

// --- Cloud Function device gateway (required; Firestore rules block unauthenticated REST) ---
// After deploying functions: https://us-central1-iot-switch-23826.cloudfunctions.net/deviceSync
#define DEVICE_SYNC_URL     "https://us-central1-iot-switch-23826.cloudfunctions.net/deviceSync"

// Optional leftover for tools; device polling uses DEVICE_SYNC_URL, not the API key.
#define FIREBASE_API_KEY    "YOUR_FIREBASE_API_KEY"

// --- Device Hardware Identity ---
// Unique Device ID registered in Firestore (matches switches/{deviceId})
#define DEVICE_ID           "esp32_relay_01"

// Device Pre-Shared Key / Secret Token for hardware identity validation
#define DEVICE_SECRET_TOKEN "REPLACE_WITH_SECURE_RANDOM_DEVICE_TOKEN_64_CHAR"

// --- Hardware Pin Definitions ---
#define RELAY_PIN           23    // GPIO pin connected to relay control
#define STATUS_LED_PIN      2     // Onboard LED or status indicator
#define RELAY_ACTIVE_LOW    true  // Set true if your relay triggers on LOW (0V)

#endif // SECRETS_H
